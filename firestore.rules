rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles: users can read all profiles, but only write their own
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Crops: authenticated users can read, only farmers can create/update/delete their own
    match /crops/{cropId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'farmer';
      allow update, delete: if request.auth != null && 
        resource.data.farmer_id == request.auth.uid;
    }

    // Orders: involved parties can read their own orders
    match /orders/{orderId} {
      allow read: if request.auth != null && 
        (resource.data.farmer_id == request.auth.uid || 
         resource.data.wholesaler_id == request.auth.uid ||
         resource.data.consumer_id == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (resource.data.farmer_id == request.auth.uid || 
         resource.data.wholesaler_id == request.auth.uid);
    }

    // Bids: involved parties can read their own bids
    match /bids/{bidId} {
      allow read: if request.auth != null && 
        (resource.data.farmer_id == request.auth.uid || 
         resource.data.wholesaler_id == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        resource.data.farmer_id == request.auth.uid;
    }

    // Admin-only collections
    match /admin/{docId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
