rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user is admin
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if user owns the document (by UID matching doc ID)
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ===== PROFILES =====
    match /profiles/{userId} {
      // Anyone authenticated can read any profile (needed for farmer names, etc.)
      allow read: if isAuth();
      // Users can only write their own profile; admins can write any
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== CROPS =====
    match /crops/{cropId} {
      // Anyone authenticated can read crops (browsing marketplace)
      allow read: if isAuth();
      // Only farmers can create crops, and must be the owner
      allow create: if isAuth()
        && request.resource.data.farmer_id == request.auth.uid
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'farmer';
      // Farmer can update their own crops, admin can update any
      allow update: if isAuth() && (
        resource.data.farmer_id == request.auth.uid || isAdmin()
      );
      // Farmer can delete their own crops, admin can delete any
      allow delete: if isAuth() && (
        resource.data.farmer_id == request.auth.uid || isAdmin()
      );
    }

    // ===== BIDS =====
    match /bids/{bidId} {
      allow read: if isAuth() && (
        resource.data.wholesaler_id == request.auth.uid
        || resource.data.farmer_id == request.auth.uid
        || isAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.wholesaler_id == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.farmer_id == request.auth.uid || isAdmin()
      );
      allow delete: if isAuth() && (
        resource.data.wholesaler_id == request.auth.uid || isAdmin()
      );
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.farmer_id == request.auth.uid
        || resource.data.wholesaler_id == request.auth.uid
        || resource.data.consumer_id == request.auth.uid
        || isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.farmer_id == request.auth.uid
        || resource.data.wholesaler_id == request.auth.uid
        || resource.data.consumer_id == request.auth.uid
        || isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
